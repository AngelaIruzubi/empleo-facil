# Finales de línea iguales en todos los ordenadores (Windows, Linux y Mac)

# Por defecto: Git detecta si es texto y lo guarda con LF
* text=auto eol=lf

# Los scripts de Windows necesitan CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Archivos binarios: Git no los toca
*.jar binary
*.png binary
*.jpg binary
*.pdf binary
*.docx binary
