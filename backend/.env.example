# Plantilla de configuración.
# Cópiala como .env (en esta misma carpeta) y cambia los valores que necesites.
# El archivo .env nunca se sube a Git. Este .env.example sí, y no lleva secretos.

# Dirección del servidor de Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Modelo de Ollama (tiene que estar descargado con: ollama pull <modelo>)
OLLAMA_MODEL=llama3.2

# Temperatura entre 0 y 1. Baja = predecible, alta = creativa
OLLAMA_TEMPERATURE=0.2
